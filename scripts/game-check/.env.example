# Copy thành scripts/game-check/.env rồi điền (file .env KHÔNG được commit)

# --- Sheet danh sách game (đọc) ---
# Link hoặc ID Sheet chứa danh sách game
GAME_LIST_SHEET=https://docs.google.com/spreadsheets/d/xxxxxxxx/edit
# Tab danh sách: cặp cột A–B, C–D, E–F… = ID – Tên game
GAME_LIST_TAB=Ids Game
# Dòng bắt đầu đọc dữ liệu (2 = bỏ dòng tiêu đề)
START_ROW=2

# --- Sheet cấu hình (đọc token + ghi kết quả) ---
# Mặc định dùng VITE_CONFIG_SHEET_ID trong .env.local (Sheet cấu hình của web).
# Chỉ điền nếu muốn dùng Sheet khác.
CONFIG_SHEET=
# Tab token: cột A email, B user_id, C token (dòng 1 là tiêu đề)
TOKEN_TAB=token
# Email để tra token. Để trống = email tài khoản Google đăng nhập trong script
TOKEN_EMAIL=
# Tab ghi kết quả: 3 cột id | name | status (dòng 1 là tiêu đề).
# Mỗi lần chạy xoá & ghi lại vùng A2:C (giữ dòng tiêu đề và các cột khác).
# name = tiêu đề <title> của trang khi load được, không thì lấy tên trong tab Ids Game.
RESULT_TAB=game_id

# --- URL kiểm tra ---
# Placeholder: {id} = ID game (bắt buộc) · {token} = token (cột C) · {user_id} = user_id (cột B)
GAME_URL_TEMPLATE=https://game.company.internal/play/{id}?token={token}

# Tuỳ chọn: kiểm tra theo nội dung trang (không phân biệt hoa/thường).
# Dùng khi trang game đã gỡ vẫn trả HTTP 200.
DEAD_TEXT=
ALIVE_TEXT=

# --- Đăng nhập trang game (oauth2-proxy, Sign in with Google) ---
# Để trống: khi gặp trang "Sign In", script mở trình duyệt và hỏi dán cookie (lưu vào game-session.json).
# Hoặc dán sẵn giá trị cookie ở đây (ưu tiên hơn file đã lưu).
GAME_COOKIE=
# Tên cookie phiên (xem trong F12 → Application → Cookies), vd _oauth2_proxy hoặc _oauth2_proxy_p2pc
SESSION_COOKIE_NAME=_oauth2_proxy

# Tiêu đề trang chung chung, KHÔNG dùng làm tên game (phân tách bằng dấu phẩy).
# Gặp tiêu đề này: có tên trong Ids Game → dùng tên đó; không có tên → "Không hoạt động" và không ghi.
IGNORE_TITLES=Sign In

# --- Hiệu năng ---
CONCURRENCY=8
TIMEOUT_MS=15000

# --- HTTPS nội bộ dùng chứng chỉ riêng của công ty ---
#   EXTRA_CA_FILE = đường dẫn file CA (.pem/.crt) của công ty (khuyên dùng)
#   INSECURE_TLS=1 = bỏ qua kiểm tra chứng chỉ (chỉ dùng khi không có file CA)
EXTRA_CA_FILE=
INSECURE_TLS=0
